#!/usr/bin/env bash

TV_APP="/Applications/TradingView.app"
DIR="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"

if [ ! -d "$TV_APP" ]; then
    echo "TradingView app not found"
    exit 1
fi

# Gracefully quit TradingView if running
if pgrep -f "^$TV_APP" >/dev/null; then
    echo "Terminating TradingView..."
    osascript -e 'quit app "TradingView"'
    while pgrep -f "^$TV_APP" >/dev/null; do sleep 0.1; done
    echo "TradingView terminated."
fi

# Create runner script for Terminal
RUNNER="/tmp/tradingview_refresh_runner.command"
cat >"$RUNNER" <<EOF
#!/usr/bin/env bash
echo "=== TradingView Refresh ==="
echo ""

output=\$(arch -arm64 "$DIR/tradingview-refresh" -p 9222 -app "$TV_APP/Contents/MacOS/TradingView" 2>&1)
echo "\$output"

if echo "\$output" | grep -q 'No alerts needs to be extended'; then
    notification="No alerts updated"
else
    lines=\$(echo "\$output" | wc -l | tr -d ' ')
    notification="\$lines alerts updated"
fi

osascript -e "display notification \"\$notification\" with title \"TradingViewRefresh\""

echo ""
echo "=== Completed ==="
for i in \$(seq 30 -1 1); do printf "\rClosing in %2d seconds..." "\$i"; sleep 1; done

rm -f "\$0"
osascript -e 'tell application "Terminal" to close front window' &
EOF

chmod +x "$RUNNER"
open -a Terminal "$RUNNER"
